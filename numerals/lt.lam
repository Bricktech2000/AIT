-- less than using tuple numerals
let
  0 = \x\y.y;
  id = \x.x;
  1 = id;
  2 = \f\x.f(f x);
  3 = \f\x.f(f(f x));
  4 = 2 2;
  false = 0;
  true = \x\y.x;
  lt = \m\n\t\f.  let T = \x\y. y x in n T (\_.f) (m T (\_.t));
 lt' = \n\m. lt n m true false -- just for minimal stand alone size -- 57 bits

-- see div.lam for explanation
in lt' -- 2 2
